# The build context is the repo root (apps/token-server/Dockerfile), so
# everything the image does not need is excluded here.
#
# node_modules is not just waste: pnpm's store is a tree of symlinks, and on
# Windows those are junctions that the build context tar cannot encode —
# `archive/tar: unknown file mode` is what a missing entry here looks like.
node_modules
**/node_modules

# Build output. The image installs and runs from source through tsx.
dist
out
release
**/dist
**/out
*.tsbuildinfo
**/*.tsbuildinfo
dist-types
**/dist-types

# Secrets never belong in an image layer. On Fly they arrive as secrets.
.env
.env.*
!.env.example

.git
.github
.claude
**/.claude
openspec
coverage
*.log
