# Token server — copy to .env and fill in. Never commit .env.
# The LiveKit API credentials must exist only here, never in the desktop app.
# See specs/room-access: "Proteção das chaves do serviço de mídia".

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Shared secret the desktop app presents to request a token.
# This is what restricts token issuance to the group.
NIGORD_GROUP_SECRET=

# Optional
#
# Quantos proxies existem na frente do serviço. Sem isto, o limite de taxa
# conta o endereço do proxy — e vira um orçamento único para o grupo inteiro,
# onde um participante reconectando bloqueia todo mundo.
#   1            atrás de um túnel (cloudflared) ou do roteador do Fly
#   vazio/false  acesso direto, sem proxy (padrão)
TRUST_PROXY=

PORT=3000
HOST=0.0.0.0
TOKEN_TTL_SECONDS=600
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=1 minute
